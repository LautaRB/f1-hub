---
import fs from 'node:fs';
import path from 'node:path';
import type { CircuitTelemetryConfig, DynamicTrackSectors, DynamicTrackTurn } from '../../types/F1';

interface Props {
  circuitId: string;
  telemetry: CircuitTelemetryConfig;
  circuitName: string;
  topSpeed?: string;
}

const { circuitId, telemetry, circuitName } = Astro.props;

let viewBox = '0 0 500 500';
let trackPathD: string | null = null;
let dynamicTurns: DynamicTrackTurn[] = [];
let sectors: DynamicTrackSectors | undefined = undefined;
let mapSource: 'multiviewer' | 'local' = 'local';

// 1. Prioridad: Mapa y sectores dinámicos (MultiViewer + OpenF1)
if (telemetry.dynamicMap) {
  viewBox = telemetry.dynamicMap.viewBox;
  trackPathD = telemetry.dynamicMap.pathD;
  dynamicTurns = telemetry.dynamicMap.turns;
  sectors = telemetry.dynamicMap.sectors;
  mapSource = 'multiviewer';
}
// 2. Fallback: SVG local en public/circuits/
else if (telemetry.svgPath) {
  try {
    const cleanPath = telemetry.svgPath.replace(/^\//, '');
    const fullPath = path.join(process.cwd(), 'public', cleanPath);
    if (fs.existsSync(fullPath)) {
      const svgContent = fs.readFileSync(fullPath, 'utf-8');
      const viewBoxMatch = svgContent.match(/viewBox="([^"]+)"/);
      const pathMatch = svgContent.match(/<path[^>]*\bd="([^"]+)"/);

      if (viewBoxMatch) viewBox = viewBoxMatch[1];
      if (pathMatch) trackPathD = pathMatch[1];
    }
  } catch (err) {
    console.error(`Error leyendo SVG local para ${circuitId}:`, err);
  }
}

const vbParts = viewBox.split(/[\s,]+/).map(Number);
const vbWidth = vbParts[2] || 500;
const scale = vbWidth / 500;

const hasTurns = dynamicTurns.length > 0;
const hasSectors = Boolean(sectors);
---

<div
  data-circuit-map
  class="bg-surface border border-line rounded-2xl p-5 flex flex-col justify-between min-h-107.5 relative overflow-hidden transition-colors duration-200"
>
  <!-- Header + Filtros dinámicos -->
  <div class="flex flex-wrap items-center justify-between gap-3 z-10">
    <div class="flex items-center gap-2 text-[11px] font-mono tracking-wider text-ink-muted uppercase">
      <span class="w-2.5 h-1 rounded-full bg-f1-cyan"></span>
      <span class="w-1 h-1 rounded-full bg-f1-red"></span>
      <span class="w-1 h-1 rounded-full bg-f1-red"></span>
      <span>TELEMETRY MAP // {circuitName}</span>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {hasSectors && (
        <button
          type="button"
          data-toggle="sectors"
          class="px-2.5 py-1 rounded-lg text-[11px] font-mono border border-line bg-muted text-ink-muted hover:text-ink hover:border-ink-muted/60 transition-colors cursor-pointer"
        >
          Sectores
        </button>
      )}

      {hasTurns && (
        <button
          type="button"
          data-toggle="turns"
          class="px-2.5 py-1 rounded-lg text-[11px] font-mono border border-line bg-muted text-ink-muted hover:text-ink hover:border-ink-muted/60 transition-colors cursor-pointer"
        >
          Curvas ({dynamicTurns.length})
        </button>
      )}
    </div>
  </div>

  <!-- Renderizado SVG en Capas -->
  <div class="flex-1 flex items-center justify-center py-6">
    {trackPathD ? (
      <svg
        viewBox={viewBox}
        class="w-full max-w-135 max-h-87.5 overflow-visible"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Capa 1: Borde exterior / sombra -->
        <path
          d={trackPathD}
          stroke-width={13 * scale}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-slate-300 dark:stroke-slate-800 transition-colors duration-300"
        />

        <!-- Capa 2: Trazado original limpio -->
        <path
          data-base-track
          d={trackPathD}
          stroke-width={5.5 * scale}
          stroke-linecap="round"
          stroke-linejoin="round"
          class="stroke-slate-700 dark:stroke-slate-200 transition-all duration-300"
        />

        <!-- Capa 3: Sectores dinámicos desde OpenF1 -->
        {sectors && (
          <g data-layer="sectors" class="opacity-0 transition-opacity duration-300 pointer-events-none">
            <path d={sectors.s1} stroke-width={6 * scale} stroke-linecap="round" stroke-linejoin="round" class="stroke-f1-red" />
            <path d={sectors.s2} stroke-width={6 * scale} stroke-linecap="round" stroke-linejoin="round" class="stroke-f1-cyan" />
            <path d={sectors.s3} stroke-width={6 * scale} stroke-linecap="round" stroke-linejoin="round" class="stroke-amber-500 dark:stroke-amber-400" />
          </g>
        )}

        <!-- Capa 4: Curvas dinámicas desde MultiViewer -->
        {hasTurns && (
          <g data-layer="turns" class="opacity-0 transition-opacity duration-300 pointer-events-none">
            {dynamicTurns.map((turn) => (
              <g>
                <circle
                  cx={turn.x}
                  cy={turn.y}
                  r={10 * scale}
                  stroke-width={1.5 * scale}
                  class="fill-surface stroke-ink-muted"
                />
                <text
                  x={turn.x}
                  y={turn.y}
                  font-size={9 * scale}
                  font-weight="700"
                  font-family="ui-monospace, monospace"
                  text-anchor="middle"
                  dominant-baseline="central"
                  class="fill-ink"
                >
                  {turn.label}
                </text>
              </g>
            ))}
          </g>
        )}
      </svg>
    ) : (
      <div class="text-center text-ink-muted font-mono text-xs border border-dashed border-line rounded-xl px-6 py-10">
        MAPA NO DISPONIBLE ({circuitId.toUpperCase()})
      </div>
    )}
  </div>

  <!-- Footer + Leyenda dinámica -->
  <div class="flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-ink-muted uppercase">
    <span>CIRCUIT ID: {circuitId} · {mapSource}</span>

    <div data-legend="sectors" class="hidden items-center gap-3 text-ink">
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-0.5 bg-f1-red"></span> S1</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-0.5 bg-f1-cyan"></span> S2</span>
      <span class="flex items-center gap-1.5"><span class="w-2.5 h-0.5 bg-amber-500 dark:bg-amber-400"></span> S3</span>
    </div>
  </div>
</div>

<script>
  const ACTIVE_STYLES: Record<string, string[]> = {
    sectors: ['border-f1-cyan/60', 'bg-f1-cyan/15', 'text-f1-cyan'],
    turns: ['border-ink/30', 'bg-ink/10', 'text-ink'],
  };

  document.querySelectorAll<HTMLElement>('[data-circuit-map]').forEach((container) => {
    const baseTrack = container.querySelector<SVGPathElement>('[data-base-track]');

    container.querySelectorAll<HTMLButtonElement>('[data-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.toggle;
        if (!key) return;

        const layer = container.querySelector<SVGGElement>(`[data-layer="${key}"]`);
        const legend = container.querySelector<HTMLElement>(`[data-legend="${key}"]`);
        if (!layer) return;

        const isActive = layer.classList.toggle('opacity-100');
        layer.classList.toggle('opacity-0', !isActive);

        (ACTIVE_STYLES[key] || []).forEach((cls) => btn.classList.toggle(cls, isActive));
        btn.classList.toggle('text-ink-muted', !isActive);
        btn.classList.toggle('border-line', !isActive);
        btn.classList.toggle('bg-muted', !isActive);

        if (legend) {
          legend.classList.toggle('flex', isActive);
          legend.classList.toggle('hidden', !isActive);
        }

        if (key === 'sectors' && baseTrack) {
          baseTrack.classList.toggle('opacity-20', isActive);
        }
      });
    });
  });
</script>