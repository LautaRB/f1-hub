---
import fs from 'node:fs';
import path from 'node:path';
import type { CircuitTelemetryConfig, DynamicTrackTurn } from '../../types/F1';

interface Props {
  circuitId: string;
  telemetry: CircuitTelemetryConfig;
  circuitName: string;
  topSpeed?: string;
}

const { circuitId, telemetry, circuitName } = Astro.props;

let viewBox = '0 0 500 500';
let trackPathD: string | null = null;
let dynamicTurns: DynamicTrackTurn[] = [];
let mapSource: 'multiviewer' | 'local' = 'local';

// 1. Prioridad: Mapa dinámico de MultiViewer
if (telemetry.dynamicMap) {
  viewBox = telemetry.dynamicMap.viewBox;
  trackPathD = telemetry.dynamicMap.pathD;
  dynamicTurns = telemetry.dynamicMap.turns;
  mapSource = 'multiviewer';
}
// 2. Fallback: SVG local en public/circuits/
else if (telemetry.svgPath) {
  try {
    const cleanPath = telemetry.svgPath.replace(/^\//, '');
    const fullPath = path.join(process.cwd(), 'public', cleanPath);
    if (fs.existsSync(fullPath)) {
      const svgContent = fs.readFileSync(fullPath, 'utf-8');
      const viewBoxMatch = svgContent.match(/viewBox="([^"]+)"/);
      const pathMatch = svgContent.match(/<path[^>]*\bd="([^"]+)"/);

      if (viewBoxMatch) viewBox = viewBoxMatch[1];
      if (pathMatch) trackPathD = pathMatch[1];
    }
  } catch (err) {
    console.error(`Error leyendo SVG local para ${circuitId}:`, err);
  }
}

// Escala proporcional según el ancho del viewBox (funciona tanto en 500px como en 15000px de MultiViewer)
const vbParts = viewBox.split(/[\s,]+/).map(Number);
const vbWidth = vbParts[2] || 500;
const scale = vbWidth / 500;

const hasTurns = dynamicTurns.length > 0;
---

<div
  data-circuit-map
  class="bg-[#0d121d] border border-slate-800/90 rounded-2xl p-5 flex flex-col justify-between min-h-107.5 relative overflow-hidden"
>
  <!-- Header + Filtro de Curvas -->
  <div class="flex flex-wrap items-center justify-between gap-3 z-10">
    <div class="flex items-center gap-2 text-[11px] font-mono tracking-wider text-slate-400 uppercase">
      <span class="w-2.5 h-1 rounded-full bg-cyan-400"></span>
      <span class="w-1 h-1 rounded-full bg-red-500"></span>
      <span class="w-1 h-1 rounded-full bg-red-500"></span>
      <span>TELEMETRY MAP // {circuitName}</span>
    </div>

    {hasTurns && (
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-toggle="turns"
          class="px-2.5 py-1 rounded-lg text-[11px] font-mono border border-slate-800 bg-[#111621] text-slate-400 hover:text-white hover:border-slate-700 transition-colors cursor-pointer"
        >
          Curvas ({dynamicTurns.length})
        </button>
      </div>
    )}
  </div>

  <!-- Renderizado SVG en Capas -->
  <div class="flex-1 flex items-center justify-center py-6">
    {trackPathD ? (
      <svg
        viewBox={viewBox}
        class="w-full max-w-135 max-h-87.5 overflow-visible"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <!-- Capa 1: Borde exterior / sombra -->
        <path
          d={trackPathD}
          stroke="#1e293b"
          stroke-width={13 * scale}
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Capa 2: Trazado original limpio -->
        <path
          d={trackPathD}
          stroke="#e2e8f0"
          stroke-width={5.5 * scale}
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Capa 3: Curvas renderizadas directo en servidor desde MultiViewer -->
        {hasTurns && (
          <g data-layer="turns" class="opacity-0 transition-opacity duration-300 pointer-events-none">
            {dynamicTurns.map((turn) => (
              <g>
                <circle
                  cx={turn.x}
                  cy={turn.y}
                  r={10 * scale}
                  fill="#0d121d"
                  stroke="#94a3b8"
                  stroke-width={1.5 * scale}
                />
                <text
                  x={turn.x}
                  y={turn.y}
                  fill="#f8fafc"
                  font-size={9 * scale}
                  font-weight="700"
                  font-family="ui-monospace, monospace"
                  text-anchor="middle"
                  dominant-baseline="central"
                >
                  {turn.label}
                </text>
              </g>
            ))}
          </g>
        )}
      </svg>
    ) : (
      <div class="text-center text-slate-500 font-mono text-xs border border-dashed border-slate-800 rounded-xl px-6 py-10">
        MAPA NO DISPONIBLE ({circuitId.toUpperCase()})
      </div>
    )}
  </div>

  <!-- Footer -->
  <div class="flex flex-wrap items-center justify-between gap-3 text-[11px] font-mono text-slate-500 uppercase">
    <span>CIRCUIT ID: {circuitId} · {mapSource}</span>
    {hasTurns && <span class="text-slate-600">{dynamicTurns.length} TURNS</span>}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-circuit-map]').forEach((container) => {
    const btn = container.querySelector<HTMLButtonElement>('[data-toggle="turns"]');
    const layer = container.querySelector<SVGGElement>('[data-layer="turns"]');
    if (!btn || !layer) return;

    btn.addEventListener('click', () => {
      const isActive = layer.classList.toggle('opacity-100');
      layer.classList.toggle('opacity-0', !isActive);

      btn.classList.toggle('border-slate-500', isActive);
      btn.classList.toggle('bg-slate-800', isActive);
      btn.classList.toggle('text-white', isActive);

      btn.classList.toggle('border-slate-800', !isActive);
      btn.classList.toggle('bg-[#111621]', !isActive);
      btn.classList.toggle('text-slate-400', !isActive);
    });
  });
</script>