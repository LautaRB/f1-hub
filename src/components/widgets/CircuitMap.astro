---
import fs from 'node:fs';
import path from 'node:path';
import type { CircuitTelemetryConfig, TrackSegment } from '../../types/F1';

interface Props {
  circuitId: string;
  telemetry: CircuitTelemetryConfig;
  circuitName: string;
  topSpeed?: string;
}

const { circuitId, telemetry, circuitName } = Astro.props;

let viewBox = '0 0 500 500';
let trackPathD: string | null = null;

// Lectura del archivo SVG del circuito para obtener el viewBox y el path de la pista
if (telemetry.svgPath) {
  try {
    const cleanPath = telemetry.svgPath.replace(/^\//, '');
    const fullPath = path.join(process.cwd(), 'public', cleanPath);
    if (fs.existsSync(fullPath)) {
      const svgContent = fs.readFileSync(fullPath, 'utf-8');
      const viewBoxMatch = svgContent.match(/viewBox="([^"]+)"/);
      // Captura el primer <path d="..."> del circuito
      const pathMatch = svgContent.match(/<path[^>]*\bd="([^"]+)"/);

      if (viewBoxMatch) viewBox = viewBoxMatch[1];
      if (pathMatch) trackPathD = pathMatch[1];
    }
  } catch (err) {
    console.error(`Error leyendo SVG para ${circuitId}:`, err);
  }
}

// Helper para convertir un rango (start..end) en stroke-dasharray y offset
function getSegmentAttrs(seg: TrackSegment) {
  const len = Math.max(0, seg.end - seg.start);
  return {
    'stroke-dasharray': `${len} ${100 - len}`,
    'stroke-dashoffset': `${-seg.start}`,
  };
}

const sectors = telemetry.mapTelemetry?.sectors;
const drsSegments = telemetry.mapTelemetry?.drsSegments ?? [];
---

<div class="bg-[#0d121d] border border-slate-800/90 rounded-2xl p-5 flex flex-col justify-between min-h-105 relative overflow-hidden">
  
  <!-- Header del Mapa + Leyenda -->
  <div class="flex flex-wrap items-center justify-between gap-3 z-10">
    <div class="flex items-center gap-2 text-[11px] font-mono tracking-wider text-slate-400 uppercase">
      <span class="w-2.5 h-1 rounded-full bg-cyan-400"></span>
      <span class="w-1 h-1 rounded-full bg-red-500"></span>
      <span class="w-1 h-1 rounded-full bg-red-500"></span>
      <span>TELEMETRY MAP // {circuitName}</span>
    </div>

    <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono text-slate-400">
      {sectors && (
        <>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-0.5 bg-red-500 inline-block"></span> S1
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-0.5 bg-sky-400 inline-block"></span> S2
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-2.5 h-0.5 bg-amber-400 inline-block"></span> S3
          </span>
        </>
      )}
      {drsSegments.length > 0 && (
        <span class="flex items-center gap-1.5 text-emerald-400">
          <span class="w-2.5 h-0.5 bg-emerald-400 inline-block shadow-[0_0_6px_#34d399]"></span> DRS Zone
        </span>
      )}
    </div>
  </div>

  <!-- Renderizado SVG en Capas -->
  <div class="flex-1 flex items-center justify-center py-6">
    {trackPathD ? (
      <svg
        viewBox={viewBox}
        class="w-full max-w-130 max-h-85 overflow-visible"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <!-- Glow para las zonas de DRS -->
          <filter id="drs-glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="3.5" result="blur" />
            <feMerge>
              <feMergeNode in="blur" />
              <feMergeNode in="SourceGraphic" />
            </feMerge>
          </filter>
        </defs>

        <!-- Capa 1: Borde exterior / sombra de pista -->
        <path
          d={trackPathD}
          stroke="#1e293b"
          stroke-width="14"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Capa 2: Trazado base (se ve blanco si el circuito aún no tiene sectores) -->
        <path
          d={trackPathD}
          stroke={sectors ? '#334155' : '#e2e8f0'}
          stroke-width="6"
          stroke-linecap="round"
          stroke-linejoin="round"
        />

        <!-- Capa 3: Sectores 1, 2 y 3 -->
        {sectors && (
          <>
            <path
              d={trackPathD}
              pathLength="100"
              stroke="#ef4444"
              stroke-width="6"
              stroke-linecap="round"
              stroke-linejoin="round"
              {...getSegmentAttrs(sectors.s1)}
            />
            <path
              d={trackPathD}
              pathLength="100"
              stroke="#38bdf8"
              stroke-width="6"
              stroke-linecap="round"
              stroke-linejoin="round"
              {...getSegmentAttrs(sectors.s2)}
            />
            <path
              d={trackPathD}
              pathLength="100"
              stroke="#fbbf24"
              stroke-width="6"
              stroke-linecap="round"
              stroke-linejoin="round"
              {...getSegmentAttrs(sectors.s3)}
            />
          </>
        )}

        <!-- Capa 4: Zonas de DRS (verde neón encima de los sectores) -->
        {drsSegments.map((zone) => (
          <path
            d={trackPathD}
            pathLength="100"
            stroke="#22c55e"
            stroke-width="9"
            stroke-linecap="round"
            stroke-linejoin="round"
            filter="url(#drs-glow)"
            {...getSegmentAttrs(zone)}
          />
        ))}
      </svg>
    ) : (
      <div class="text-center text-slate-500 font-mono text-xs border border-dashed border-slate-800 rounded-xl px-6 py-10">
        MAPA NO DISPONIBLE ({circuitId.toUpperCase()})
      </div>
    )}
  </div>

  <!-- Footer -->
  <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 uppercase">
    <span>CIRCUIT ID: {circuitId}</span>
    {sectors && <span class="text-slate-600">TELEMETRY OVERLAY ACTIVE</span>}
  </div>

</div>