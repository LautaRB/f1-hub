---
import type { CircuitTelemetryConfig } from '../../types/F1';

interface Props {
  circuitId: string;
  telemetry: CircuitTelemetryConfig;
  circuitName: string;
  topSpeed: string;
}

const { circuitId, telemetry, circuitName, topSpeed } = Astro.props;
---

<div class="relative bg-[#111621] border border-slate-800/90 rounded-2xl p-6 min-h-102.5 flex flex-col justify-between overflow-hidden shadow-2xl">
  
  <!-- Cabecera del visor estilo HUD -->
  <div class="flex flex-wrap items-center justify-between gap-2 z-10">
    <div class="flex items-center gap-1.5">
      <span class="w-4 h-1.5 rounded-xs bg-cyan-400"></span>
      <span class="w-1.5 h-1.5 rounded-xs bg-red-500"></span>
      <span class="w-1.5 h-1.5 rounded-xs bg-red-500"></span>
      <span class="text-xs font-mono uppercase tracking-wider text-slate-300 ml-2">
        Telemetry Map // {circuitName}
      </span>
    </div>

    <!-- Leyenda de colores -->
    <div class="flex items-center gap-3 text-[10px] font-mono text-slate-400">
      <span class="flex items-center gap-1">
        <span class="w-2.5 h-1 bg-emerald-400 rounded-full"></span> DRS Zone
      </span>
      <span class="flex items-center gap-1">
        <span class="w-2.5 h-1 bg-yellow-400 rounded-full"></span> Sector 2
      </span>
      <span class="flex items-center gap-1">
        <span class="w-2.5 h-1 bg-red-500 rounded-full"></span> Hard Braking
      </span>
    </div>
  </div>

  <!-- Matriz de puntos de fondo -->
  <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] bg-size-[20px_20px] opacity-40 pointer-events-none"></div>

  <!-- Contenedor del Trazado SVG DINÁMICO -->
  <div class="my-8 relative z-10 flex items-center justify-center min-h-[300px]">
    {telemetry.svgPath ? (
      <img 
        src={telemetry.svgPath} 
        alt={`Circuito de ${circuitName}`} 
        class="w-full max-w-xl h-auto drop-shadow-[0_0_15px_rgba(56,189,248,0.2)] filter invert opacity-90"
      />
    ) : (
      <div class="text-slate-500 font-mono text-sm border border-slate-700 p-4 rounded-lg bg-slate-800/50">
        [ ERROR: MAPA NO DISPONIBLE PARA {circuitId.toUpperCase()} ]
      </div>
    )}
  </div>

  <!-- Pie del visor con datos rápidos -->
  <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 z-10 pt-2 border-t border-slate-800/60">
    <span>CIRCUIT ID: {circuitId.toUpperCase()}</span>
    <span>TOP SPEED REGISTRADA: <strong class="text-emerald-400">{topSpeed}</strong></span>
  </div>
</div>