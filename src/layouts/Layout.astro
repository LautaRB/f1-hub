---
import '../styles/global.css';

import { getRaceStatus, type RaceStatusBadge } from '../utils/raceStatus';

interface Props {
  title?: string;
  raceDate?: string;
}

const { title = 'F1 Hub — Telemetry & Race Control', raceDate } = Astro.props;
const currentPath = Astro.url.pathname;

const status: RaceStatusBadge = getRaceStatus(raceDate);

const navLinks = [
  { name: 'Campeonato', href: '/standings' },
  { name: 'Campeonato de Constructores', href: '/constructors' },
  { name: 'Equipos', href: '/teams' },
  { name: 'Pilotos', href: '/drivers' },
  { name: 'Circuitos', href: '/circuits' },
  { name: 'Calendario', href: '/calendar' },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link rel="icon" href="/favicon.ico?v=2" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@1,800;1,900&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="bg-[#0b0e14] text-slate-100 antialiased selection:bg-red-600 selection:text-white min-h-screen flex flex-col">
    
    <!-- Top Navbar -->
    <header class="h-16 border-b border-slate-800/80 bg-[#0b0e14]/90 backdrop-blur-md sticky top-0 z-50 px-4 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-10">
        <a href="/" class="flex items-center gap-2.5 group">
          <span
            class="text-xl font-black italic tracking-tight leading-none flex items-baseline"
            style="font-family: 'Exo 2', sans-serif;"
          >
            <span class="text-red-500">F1</span>
            <span class="text-white ml-1">Hub</span>
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 ml-0.5 inline-block"></span>
          </span>
        </a>

        <nav class="hidden md:flex items-center gap-6">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class:list={[
                  'text-sm font-medium transition-colors py-1 border-b-2',
                  isActive ? 'text-white border-red-600' : 'text-slate-400 border-transparent hover:text-slate-100',
                ]}
              >
                {link.name}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- Badge de Status Dinámico -->
      <div class:list={['flex items-center gap-2 px-3 py-1.5 rounded-full border text-xs font-mono', status.bgColor]}>
        <span class="text-slate-400">Status</span>
        <div class="flex items-center gap-1.5">
          <span class:list={['w-2 h-2 rounded-full', status.dotColor, status.pulse && 'animate-ping']} />
          <span class:list={['font-bold tracking-wider', status.textColor]}>{status.label}</span>
        </div>
      </div>
    </header>

    <!-- Sidebar y Main -->
    <div class="flex-1 flex">
      <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
        <slot />
      </main>
    </div>

  </body>
</html>