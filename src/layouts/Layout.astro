---
import "../styles/global.css";

interface Props {
  title?: string;
}

const { title = 'F1 Hub — Telemetry & Race Control' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Campeonato', href: '/standings' },
  { name: 'Campeonato de Constructores', href: '/constructors' },
  { name: 'Equipos', href: '/teams' },
  { name: 'Pilotos', href: '/drivers' },
  { name: 'Circuitos', href: '/circuits' },
  { name: 'Calendario', href: '/calendar' },
];
---

<!doctype html>
<html lang="es" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body class="bg-[#0b0e14] text-slate-100 antialiased selection:bg-red-600 selection:text-white min-h-screen flex flex-col">
    
    <!-- Top Navbar -->
    <header class="h-16 border-b border-slate-800/80 bg-[#0b0e14]/90 backdrop-blur-md sticky top-0 z-50 px-4 lg:px-8 flex items-center justify-between">
      <div class="flex items-center gap-10">
        <a href="/" class="text-2xl font-black tracking-tighter italic text-red-600 hover:opacity-90 transition-opacity">
          F1 Hub
        </a>

        <nav class="hidden md:flex items-center gap-6">
          {navLinks.map((link) => {
            const isActive = currentPath === link.href;
            return (
              <a
                href={link.href}
                class:list={[
                  'text-sm font-medium transition-colors py-1 border-b-2',
                  isActive
                    ? 'text-white border-red-600'
                    : 'text-slate-400 border-transparent hover:text-slate-100',
                ]}
              >
                {link.name}
              </a>
            );
          })}
        </nav>
      </div>

      <div class="flex items-center gap-2 text-xs font-mono text-slate-400 bg-[#121722] border border-slate-800 px-3 py-1.5 rounded-full">
        <span>Status</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      </div>
    </header>

    <!-- Contenedor con Sidebar Lateral + Contenido -->
    <div class="flex-1 flex">
      <!-- Mini Sidebar de Telemetría -->
      <aside class="hidden sm:flex w-14 border-r border-slate-800/80 bg-[#0d1118] flex-col items-center py-6 justify-between text-slate-500">
        <div class="flex flex-col gap-6 items-center">
          <a href="/" title="Dashboard Telemetría" class="p-2 rounded-lg bg-red-600/15 text-red-500 border border-red-600/30">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </a>
          <a href="/circuits" title="Mapa de Pista" class="p-2 rounded-lg hover:text-slate-200 transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" />
            </svg>
          </a>
        </div>
        <span class="text-[10px] font-mono uppercase tracking-widest -rotate-90 whitespace-nowrap text-slate-600">
          F1-TEL v1.0
        </span>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8">
        <slot />
      </main>
    </div>

  </body>
</html>