---
import Layout from '../../layouts/Layout.astro';
import { getAllCircuits } from '../../services/f1Api';

const circuits = await getAllCircuits();
const currentSeasonCircuits = circuits.filter((c) => c.inCurrentSeason);
const season = currentSeasonCircuits[0]?.seasonData?.season ?? new Date().getFullYear();

const totalCount = circuits.length;
const seasonCount = currentSeasonCircuits.length;
const historicCount = totalCount - seasonCount;

function formatShortDate(dateStr: string) {
  return new Intl.DateTimeFormat('es-AR', {
    day: '2-digit',
    month: 'short',
    timeZone: 'UTC',
  }).format(new Date(`${dateStr}T00:00:00Z`));
}
---

<Layout title="Circuitos — F1 Hub">
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <header class="flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="border-l-2 border-red-500 pl-4">
        <p class="text-xs font-mono uppercase tracking-widest text-ink-muted">
          Catálogo oficial · Temporada {season} e históricos
        </p>
        <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-ink mt-1">
          CIRCUITOS
        </h1>
      </div>

      <div class="flex flex-wrap gap-3 font-mono text-xs">
        <div class="bg-surface border border-line rounded-lg px-3.5 py-2">
          <span class="text-ink-muted block">TOTAL</span>
          <span class="text-ink text-sm font-bold">{totalCount}</span>
        </div>
        <div class="bg-surface border border-line rounded-lg px-3.5 py-2">
          <span class="text-f1-red block">TEMP. {season}</span>
          <span class="text-ink text-sm font-bold">{seasonCount}</span>
        </div>
        <div class="bg-surface border border-line rounded-lg px-3.5 py-2">
          <span class="text-f1-cyan block">HISTÓRICOS</span>
          <span class="text-ink text-sm font-bold">{historicCount}</span>
        </div>
      </div>
    </header>

    <section class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-center justify-between">
      <div class="relative flex-1 max-w-md">
        <input
          id="circuit-search"
          type="search"
          placeholder="Buscar por circuito, ciudad, país o GP..."
          class="w-full bg-surface border border-line rounded-lg px-4 py-2.5 text-sm text-ink placeholder:text-ink-muted focus:outline-none focus:border-f1-cyan transition-colors"
        />
      </div>

      <div class="flex flex-wrap gap-2" role="group" aria-label="Filtrar circuitos">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider border border-red-500/60 bg-red-500/15 text-f1-red transition-colors"
        >
          Todos
        </button>
        <button
          type="button"
          data-filter="season"
          class="filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider border border-line bg-surface text-ink-muted hover:text-ink-muted transition-colors"
        >
          Temporada {season}
        </button>
        <button
          type="button"
          data-filter="sprint"
          class="filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider border border-line bg-surface text-ink-muted hover:text-ink-muted transition-colors"
        >
          Sprint
        </button>
        <button
          type="button"
          data-filter="historic"
          class="filter-btn px-3.5 py-2 rounded-lg text-xs font-mono uppercase tracking-wider border border-line bg-surface text-ink-muted hover:text-ink-muted transition-colors"
        >
          Históricos
        </button>
      </div>
    </section>

    <section id="circuits-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {circuits.map((circuit) => {
        const isNext = circuit.seasonData?.status === 'next';

        return (
          <a
            href={`/circuits/${circuit.circuitId}`}
            class:list={[
              'circuit-card group relative flex flex-col justify-between bg-surface border rounded-xl p-5 transition-all duration-200 hover:-translate-y-0.5',
              isNext
                ? 'border-red-500/60 ring-1 ring-red-500/20'
                : 'border-line hover:border-slate-600',
            ]}
            data-season={String(circuit.inCurrentSeason)}
            data-sprint={String(Boolean(circuit.seasonData?.hasSprint))}
            data-search={`${circuit.circuitName} ${circuit.seasonData?.raceName ?? ''} ${circuit.locality} ${circuit.country}`.toLowerCase()}
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-mono text-xs text-ink-muted">
                  {circuit.seasonData
                    ? `R${String(circuit.seasonData.round).padStart(2, '0')} · ${formatShortDate(circuit.seasonData.date)}`
                    : 'HISTÓRICO'}
                </span>

                <div class="flex items-center gap-1.5">
                  {circuit.seasonData?.hasSprint && (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-sky-400/10 text-f1-cyan border border-sky-400/30">
                      Sprint
                    </span>
                  )}
                  {isNext && (
                    <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-red-500/15 text-f1-red border border-red-500/40">
                      Próximo
                    </span>
                  )}
                </div>
              </div>

              {circuit.svgPath && (
                <div class="h-28 my-3 flex items-center justify-center rounded-lg bg-muted border border-line p-3">
                  <img
                    src={circuit.svgPath}
                    alt={`Trazado de ${circuit.circuitName}`}
                    loading="lazy"
                    class="max-h-full max-w-full object-contain invert dark:invert-0 opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-200"
                  />
                </div>
              )}

              <h2 class="text-lg font-bold text-ink group-hover:text-f1-red transition-colors leading-snug">
                {circuit.circuitName}
              </h2>
              <p class="text-sm text-ink-muted mt-1">
                {circuit.seasonData?.raceName ?? `${circuit.locality}, ${circuit.country}`}
              </p>
            </div>

            <div class="mt-5 pt-3.5 border-t border-line flex items-center justify-between gap-2 text-xs">
              <span class="text-ink-muted truncate">
                {circuit.locality}, {circuit.country}
              </span>
              <span class="font-mono text-[11px] text-f1-cyan group-hover:translate-x-0.5 transition-transform shrink-0">
                Ver detalle →
              </span>
            </div>
          </a>
        );
      })}
    </section>

    <p id="circuits-empty" class="hidden text-center text-sm text-slate-500 py-8">
      No hay circuitos que coincidan con ese filtro.
    </p>
  </main>
</Layout>

<script>
  const searchInput = document.getElementById('circuit-search') as HTMLInputElement | null;
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.circuit-card');
  const emptyState = document.getElementById('circuits-empty');

  let activeFilter = 'all';

  function applyFilters() {
    const query = (searchInput?.value ?? '').trim().toLowerCase();
    let visibleCount = 0;

    cards.forEach((card) => {
      const inSeason = card.dataset.season === 'true';
      const isSprint = card.dataset.sprint === 'true';
      const haystack = card.dataset.search ?? '';

      const matchesFilter =
        activeFilter === 'all' ||
        (activeFilter === 'season' && inSeason) ||
        (activeFilter === 'sprint' && isSprint) ||
        (activeFilter === 'historic' && !inSeason);

      const matchesSearch = !query || haystack.includes(query);
      const isVisible = matchesFilter && matchesSearch;

      card.classList.toggle('hidden', !isVisible);
      if (isVisible) visibleCount++;
    });

    emptyState?.classList.toggle('hidden', visibleCount > 0);
  }

  searchInput?.addEventListener('input', applyFilters);

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';

      filterButtons.forEach((b) => {
        const isCurrent = b === btn;
        b.classList.toggle('border-f1-red/60', isCurrent);
        b.classList.toggle('bg-f1-red/15', isCurrent);
        b.classList.toggle('text-f1-red', isCurrent);
        b.classList.toggle('border-line', !isCurrent);
        b.classList.toggle('bg-surface', !isCurrent);
        b.classList.toggle('text-ink-muted', !isCurrent);
      });

      applyFilters();
    });
  });
</script>