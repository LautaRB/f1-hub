---
import Layout from '../../layouts/Layout.astro';
import CircuitMap from '../../components/widgets/CircuitMap.astro';
import CircuitWeather from '../../components/widgets/CircuitWeather.astro';
import { getAllCircuits, getCircuitTelemetry, type CircuitItem } from '../../services/f1Api';

export async function getStaticPaths() {
  const circuits = await getAllCircuits();

  return circuits.map((circuit) => ({
    params: { id: circuit.circuitId },
    props: { circuit },
  }));
}

interface Props {
  circuit: CircuitItem;
}

const { circuit } = Astro.props;

const telemetry =
  circuit.inCurrentSeason && circuit.seasonData
    ? await getCircuitTelemetry(
        circuit.circuitId,
        circuit.seasonData.season,
        circuit.seasonData.date,
        circuit.svgPath
      )
    : null;
---

<Layout title={`${circuit.circuitName} — F1 Hub`}>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Volver + Header -->
    <div class="space-y-4">
      <a
        href="/circuits/circuits"
        class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-slate-400 hover:text-white transition-colors"
      >
        ← Volver a circuitos
      </a>

      <header class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="border-l-2 border-red-500 pl-4">
          <div class="flex flex-wrap items-center gap-2 mb-1">
            <span class="text-xs font-mono uppercase tracking-widest text-slate-400">
              {circuit.seasonData
                ? `Temporada ${circuit.seasonData.season} · Ronda ${circuit.seasonData.round}`
                : 'Circuito Histórico de F1'}
            </span>
            {circuit.seasonData?.hasSprint && (
              <span class="px-2 py-0.5 rounded text-[10px] font-mono uppercase tracking-wider bg-sky-400/10 text-sky-400 border border-sky-400/30">
                Sprint
              </span>
            )}
          </div>
          <h1 class="text-3xl sm:text-4xl font-black tracking-tight text-white">
            {circuit.circuitName}
          </h1>
          <p class="text-slate-400 mt-1">
            {circuit.locality}, {circuit.country}
          </p>
        </div>

        <a
          href={circuit.wikiUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="self-start md:self-auto px-4 py-2 rounded-lg text-xs font-mono uppercase tracking-wider bg-[#0d111a] border border-slate-800 text-slate-300 hover:border-sky-400/60 hover:text-sky-400 transition-colors"
        >
          Ficha Wikipedia ↗
        </a>
      </header>
    </div>

    <!-- Layout principal: Mapa (8 cols) + Panel lateral (4 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Columna izquierda -->
      <div class="lg:col-span-8 flex flex-col gap-5">
        {telemetry ? (
          <>
            <CircuitMap
              circuitId={circuit.circuitId}
              telemetry={telemetry}
              circuitName={circuit.circuitName}
              topSpeed={telemetry.topSpeed}
            />

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
              <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
                <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
                <span class="text-xs text-slate-400 block mb-1">Longitud:</span>
                <span class="text-xl lg:text-2xl font-black text-white">{telemetry.length}</span>
              </div>

              <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
                <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
                <span class="text-xs text-slate-400 block mb-1">Vueltas:</span>
                <span class="text-xl lg:text-2xl font-black text-white">{telemetry.laps}</span>
              </div>

              <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
                <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
                <span class="text-xs text-slate-400 block mb-1">Top Speed:</span>
                <span class="text-xl lg:text-2xl font-black text-white">{telemetry.topSpeed || 'N/A'}</span>
              </div>

              <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
                <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
                <span class="text-xs text-slate-400 block mb-1">Récord de Vuelta:</span>
                <div class="flex flex-col">
                  <span class="text-xl lg:text-2xl font-black text-white">{telemetry.lapRecord?.time || 'N/A'}</span>
                  <span class="text-[10px] text-slate-400 truncate">
                    {telemetry.lapRecord ? `${telemetry.lapRecord.driver} (${telemetry.lapRecord.year})` : ''}
                  </span>
                </div>
              </div>
            </div>
          </>
        ) : (
          <section class="bg-[#0d111a] border border-slate-800/80 rounded-2xl p-6 flex flex-col">
            <div class="flex items-center justify-between border-b border-slate-800/80 pb-3 mb-6">
              <div class="flex items-center gap-2">
                <span class="w-4 h-1 rounded-full bg-sky-400"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span>
                <span class="font-mono text-xs tracking-widest text-slate-400 uppercase">
                  TRACK LAYOUT // {circuit.circuitId.toUpperCase()}
                </span>
              </div>
              <span class="font-mono text-xs text-slate-500">
                {circuit.coordinates.lat.toFixed(4)}°, {circuit.coordinates.lon.toFixed(4)}°
              </span>
            </div>

            <div class="flex-1 min-h-80 flex items-center justify-center rounded-xl bg-[#090d14] border border-slate-800/60 p-8">
              {circuit.svgPath ? (
                <img
                  src={circuit.svgPath}
                  alt={`Trazado del circuito ${circuit.circuitName}`}
                  class="max-h-90 w-full object-contain"
                />
              ) : (
                <p class="font-mono text-xs text-slate-500 uppercase tracking-wider">
                  Circuito no disponible
                </p>
              )}
            </div>
          </section>
        )}
      </div>

      <!-- Columna derecha: Datos + Clima en vivo -->
      <aside class="lg:col-span-4 space-y-6">
        <section class="bg-[#0d111a] border border-slate-800/80 rounded-2xl p-6 space-y-4">
          <h2 class="text-base font-bold text-white border-b border-slate-800/80 pb-3">
            Información del Circuito
          </h2>

          <dl class="space-y-3 text-sm">
            {circuit.seasonData && (
              <>
                <div class="flex justify-between gap-4">
                  <dt class="text-slate-400">Gran Premio</dt>
                  <dd class="text-white font-medium text-right">{circuit.seasonData.raceName}</dd>
                </div>
                <div class="flex justify-between gap-4">
                  <dt class="text-slate-400">Fecha</dt>
                  <dd class="text-slate-200 font-mono text-xs text-right">
                    {circuit.seasonData.date}
                  </dd>
                </div>
              </>
            )}
            <div class="flex justify-between gap-4">
              <dt class="text-slate-400">Ciudad</dt>
              <dd class="text-slate-200 text-right">{circuit.locality}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-slate-400">País</dt>
              <dd class="text-slate-200 text-right">{circuit.country}</dd>
            </div>
          </dl>
        </section>

        <CircuitWeather
          lat={circuit.coordinates.lat}
          lon={circuit.coordinates.lon}
          locality={circuit.locality}
        />
      </aside>
    </div>
  </main>
</Layout>