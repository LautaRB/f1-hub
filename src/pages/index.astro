---
import Layout from '../layouts/Layout.astro';
import CircuitMap from '../components/widgets/CircuitMap.astro';
import { getNextRaceData, formatSessionToArgTime } from '../services/f1Api';

const race = await getNextRaceData();
const telemetry = race?.telemetry;
---

<Layout raceDate={race?.date}>
  {race && telemetry ? (
    <div class="flex flex-col gap-6">
      
      <!-- Encabezado superior -->
      <div class="border-l-2 border-red-600 pl-4 py-0.5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="text-xs font-medium text-slate-400 block mb-0.5">
            Próximo circuito · Ronda {race.round}
          </span>
          <h1 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white">
            {race.raceName}
          </h1>
          <p class="text-sm text-slate-400 mt-0.5">
            {race.circuit.circuitName} — {race.circuit.locality}, {race.circuit.country}
          </p>
        </div>
      </div>

      <!-- Grilla Principal -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- Columna Izquierda (8 cols): Mapa Modular + Métricas -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          
          <!-- Renderizado del Componente de Mapa -->
          <CircuitMap 
            circuitId={race.circuit.circuitId}
            telemetry={telemetry}
            circuitName={race.circuit.circuitName}
            topSpeed={telemetry.topSpeed} 
          />

          <!-- 4 Cajas Inferiores de Métricas (Ajustado a grid-cols-4) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Longitud:</span>
              <span class="text-xl lg:text-2xl font-black text-white">{telemetry.length}</span>
            </div>

            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Vueltas:</span>
              <span class="text-xl lg:text-2xl font-black text-white">{telemetry.laps}</span>
            </div>

            <!-- Top Speed -->
            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Top Speed:</span>
              <span class="text-xl lg:text-2xl font-black text-white">{telemetry.topSpeed || 'N/A'}</span>
            </div>

            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Récord de Vuelta:</span>
              <div class="flex flex-col">
                <span class="text-xl lg:text-2xl font-black text-white">{telemetry.lapRecord?.time || 'N/A'}</span>
                <span class="text-[10px] text-slate-400 truncate">
                  {telemetry.lapRecord ? `${telemetry.lapRecord.driver} (${telemetry.lapRecord.year})` : ''}
                </span>
              </div>
            </div>
          </div>

        </div>

        <!-- Columna Derecha (4 cols): Información del GP y Cronograma -->
        <aside class="lg:col-span-4 bg-[#111621] border border-slate-800/90 rounded-2xl p-5 flex flex-col gap-6">
          
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h2 class="text-base font-bold text-white">Información del GP</h2>
            <span class="text-xs font-mono text-slate-500">GMT-3 (ARG)</span>
          </div>

          <!-- Zonas de DRS -->
          <div class="bg-[#0d111a] border border-slate-800/80 rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-3">Zonas de DRS (Overtake)</h3>
            
            <div class="flex items-center gap-4">
              <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg w-16 h-16 flex flex-col items-center justify-center shrink-0">
                <span class="text-3xl font-black text-emerald-400 leading-none">{telemetry.drsZones}</span>
              </div>
              <div class="text-xs text-slate-400 leading-relaxed">
                Zonas habilitadas para activación.<br/>
                <span class="text-emerald-500/80 font-medium mt-1 inline-block">Ver el mapa del circuito para ubicaciones exactas.</span>
              </div>
            </div>
          </div>

          <!-- Cronograma -->
          <div>
            <h3 class="text-sm font-bold text-white mb-3">Cronograma del Fin de Semana</h3>

            <div class="divide-y divide-slate-800/80 border-t border-b border-slate-800/80">
              {race.sessions.map((session) => (
                <div
                  class:list={[
                    'py-3 px-2 flex items-center justify-between text-sm transition-colors',
                    session.isMain ? 'bg-red-600/10 font-bold text-white rounded-lg my-1 px-3' : 'text-slate-300',
                  ]}
                >
                  <span>{session.name}</span>
                  <span class:list={['font-mono text-xs whitespace-nowrap', session.isMain ? 'text-red-400' : 'text-slate-200']}>
                    {formatSessionToArgTime(session.date, session.time)}
                  </span>
                </div>
              ))}
            </div>
          </div>

        </aside>

      </div>
    </div>
  ) : (
    <div class="bg-[#111621] border border-slate-800 rounded-xl p-8 text-center">
      <p class="text-slate-300">No se pudo cargar la información del próximo Gran Premio.</p>
    </div>
  )}
</Layout>