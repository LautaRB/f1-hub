---
import Layout from '../layouts/Layout.astro';
import { getNextRaceData, formatSessionToArgTime } from '../services/f1Api';

const race = await getNextRaceData();
const telemetry = race?.telemetry;
---

<Layout raceDate={race?.date}>
  {race && telemetry ? (
    <div class="flex flex-col gap-6">
      
      <!-- ENCABEZADO SUPERIOR -->
      <div class="border-l-2 border-red-600 pl-4 py-0.5 flex flex-wrap items-end justify-between gap-4">
        <div>
          <span class="text-xs font-medium text-slate-400 block mb-0.5">
            Próximo circuito · Ronda {race.round}
          </span>
          <h1 class="text-2xl sm:text-4xl font-black uppercase tracking-tight text-white">
            {race.raceName}
          </h1>
          <p class="text-sm text-slate-400 mt-0.5">
            {race.circuit.circuitName} — {race.circuit.locality}, {race.circuit.country}
          </p>
        </div>
      </div>

      <!-- GRILLA PRINCIPAL -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
        
        <!-- COLUMNA IZQUIERDA (8 cols): Mapa de Circuito + 3 Cards Inferiores -->
        <div class="lg:col-span-8 flex flex-col gap-5">
          
          <!-- Visor de Telemetría del Circuito -->
          <div class="relative bg-[#111621] border border-slate-800/90 rounded-2xl p-6 min-h-102.5 flex flex-col justify-between overflow-hidden shadow-2xl">
            
            <!-- Decoración superior estilo HUD -->
            <div class="flex flex-wrap items-center justify-between gap-2 z-10">
              <div class="flex items-center gap-1.5">
                <span class="w-4 h-1.5 rounded-xs bg-cyan-400"></span>
                <span class="w-1.5 h-1.5 rounded-xs bg-red-500"></span>
                <span class="w-1.5 h-1.5 rounded-xs bg-red-500"></span>
              </div>
              <div class="flex items-center gap-4 text-[11px] font-mono text-slate-400">
                <span class="flex items-center gap-1.5">
                  <span class="w-3 h-1 bg-emerald-400 rounded-full"></span> Zona DRS / Overtake
                </span>
                <span class="flex items-center gap-1.5">
                  <span class="w-3 h-1 bg-red-500 rounded-full"></span> Frenada Fuerte (Braking)
                </span>
              </div>
            </div>

            <!-- Matriz de puntos decorativa -->
            <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] bg-size-[20px_20px] opacity-40 pointer-events-none"></div>

            <!-- Ilustración SVG adaptada a Las Vegas Strip Circuit -->
            <div class="my-4 relative z-10 flex items-center justify-center">
              <svg viewBox="0 0 700 320" class="w-full max-w-2xl h-auto">
                <!-- Sombra base del asfalto -->
                <path
                  d="M 180 230 L 560 230 C 585 230 590 205 570 190 L 545 170 L 545 110 C 545 80 510 70 485 85 C 460 100 440 120 410 110 L 340 80 C 290 65 245 75 230 115 L 220 145 L 135 145 C 105 145 100 180 125 195 L 160 205 C 140 220 150 230 180 230 Z"
                  fill="none"
                  stroke="#1e293b"
                  stroke-width="14"
                  stroke-linejoin="round"
                  stroke-linecap="round"
                />

                <!-- Línea Principal del Circuito -->
                <path
                  d="M 180 230 L 560 230 C 585 230 590 205 570 190 L 545 170 L 545 110 C 545 80 510 70 485 85 C 460 100 440 120 410 110 L 340 80 C 290 65 245 75 230 115 L 220 145 L 135 145 C 105 145 100 180 125 195 L 160 205 C 140 220 150 230 180 230 Z"
                  fill="none"
                  stroke="#bae6fd"
                  stroke-width="3.5"
                  stroke-linejoin="round"
                />

                <!-- DRS 1: Recta de The Strip (Verde) -->
                <line x1="210" y1="230" x2="535" y2="230" stroke="#10b981" stroke-width="6" stroke-linecap="round" />

                <!-- DRS 2: Tramo hacia Curva 5 (Verde) -->
                <line x1="220" y1="145" x2="145" y2="145" stroke="#10b981" stroke-width="6" stroke-linecap="round" />

                <!-- Zonas de Frenada Fuerte (Rojo) -->
                <path d="M 545 230 L 560 230 C 585 230 590 205 570 190 L 545 170" fill="none" stroke="#ef4444" stroke-width="4.5" />
                <path d="M 135 145 C 105 145 100 180 125 195 L 160 205" fill="none" stroke="#ef4444" stroke-width="4.5" />

                <!-- Etiquetas de Telemetría -->
                <text x="320" y="255" fill="#34d399" font-size="11" font-family="monospace" font-weight="bold">
                  DRS 1 — THE STRIP (1.9 KM)
                </text>
                <text x="145" y="132" fill="#34d399" font-size="11" font-family="monospace" font-weight="bold">
                  DRS 2
                </text>
                <text x="585" y="225" fill="#cbd5e1" font-size="11" font-family="monospace">
                  Turn 14 ({telemetry.specs.topSpeed})
                </text>
                <text x="55" y="175" fill="#cbd5e1" font-size="11" font-family="monospace">
                  Turn 1 (Hairpin)
                </text>
                <text x="485" y="65" fill="#94a3b8" font-size="10" font-family="monospace">
                  Sphere Section (T5-T9)
                </text>
              </svg>
            </div>

            <!-- Pie del visor -->
            <div class="flex items-center justify-between text-[11px] font-mono text-slate-500 z-10">
              <span>CIRCUIT ID: {race.circuit.circuitId.toUpperCase()}</span>
              <span>VEL. PUNTA EST.: <strong class="text-emerald-400">{telemetry.specs.topSpeed}</strong></span>
            </div>
          </div>

          <!-- 3 Cajas Inferiores de Métricas -->
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Longitud:</span>
              <span class="text-2xl font-black text-white">{telemetry.specs.length}</span>
            </div>

            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Vueltas:</span>
              <span class="text-2xl font-black text-white">{telemetry.specs.laps}</span>
            </div>

            <div class="bg-[#111621] border border-slate-800/90 rounded-xl p-4 relative">
              <span class="w-2 h-2 rounded-full bg-red-600 absolute top-3.5 right-3.5"></span>
              <span class="text-xs text-slate-400 block mb-1">Récord de Vuelta:</span>
              <div class="flex items-baseline gap-1.5 flex-wrap">
                <span class="text-2xl font-black text-white">{telemetry.specs.lapRecord.time}</span>
                <span class="text-xs text-slate-400">
                  ({telemetry.specs.lapRecord.driver}, {telemetry.specs.lapRecord.year})
                </span>
              </div>
            </div>
          </div>

        </div>

        <!-- COLUMNA DERECHA (4 cols) -->
        <aside class="lg:col-span-4 bg-[#111621] border border-slate-800/90 rounded-2xl p-5 flex flex-col gap-6">
          
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <h2 class="text-base font-bold text-white">Información del GP</h2>
            <span class="text-xs font-mono text-slate-500">GMT-3 (ARG)</span>
          </div>

          <!-- Bloque 1: Zonas de DRS (Overtake) -->
          <div class="bg-[#0d111a] border border-slate-800/80 rounded-xl p-4">
            <h3 class="text-sm font-bold text-white mb-3">Zonas de DRS (Overtake)</h3>

            <div class="space-y-4">
              {telemetry.overtakeZones.map((zone) => (
                <div class="space-y-1.5 text-xs border-b border-slate-800/60 last:border-none pb-3 last:pb-0">
                  <div class="font-semibold text-slate-200 flex items-center justify-between">
                    <span>{zone.turn}</span>
                    <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-400">
                      {zone.severity}
                    </span>
                  </div>
                  <div class="flex items-start gap-2 text-slate-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 mt-1 shrink-0"></span>
                    <div>
                      <span class="text-slate-300 font-medium">Detección:</span> {zone.detectionPoint}
                    </div>
                  </div>
                  <div class="flex items-start gap-2 text-slate-400">
                    <span class="w-2 h-2 rounded-full bg-red-500 mt-1 shrink-0"></span>
                    <div>
                      <span class="text-slate-300 font-medium">Activación:</span> {zone.activationPoint}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Bloque 2: Cronograma del Fin de Semana -->
          <div>
            <h3 class="text-sm font-bold text-white mb-3">Cronograma del Fin de Semana</h3>

            <div class="divide-y divide-slate-800/80 border-t border-b border-slate-800/80">
              {race.sessions.map((session) => (
                <div
                  class:list={[
                    'py-3 px-2 flex items-center justify-between text-sm transition-colors',
                    session.isMain ? 'bg-red-600/10 font-bold text-white rounded-lg my-1 px-3' : 'text-slate-300',
                  ]}
                >
                  <span>{session.name}</span>
                  <span class:list={['font-mono', session.isMain ? 'text-red-400' : 'text-slate-200']}>
                    {formatSessionToArgTime(session.date, session.time)}
                  </span>
                </div>
              ))}
            </div>
          </div>

        </aside>

      </div>
    </div>
  ) : (
    <div class="bg-[#111621] border border-slate-800 rounded-xl p-8 text-center">
      <p class="text-slate-300">No se pudo cargar la información del próximo Gran Premio en este momento.</p>
    </div>
  )}
</Layout>